        <mxCell id="t2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="t2 (silver)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;tx_year, tx_monthdate, covid, flat_type, resale_price, age_sold,&lt;br&gt;remaining_lease_sold, pretend_top_2025, street_name, storey_range, town&lt;br&gt;dispatch_write(overwrite_keys='tx_monthdate') — same single column on all 3 formats, overwrite-by-presence (IN-list, not window)&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="520" x="280" y="1250" as="geometry" />
        </mxCell>

        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;align=left;verticalAlign=top;spacing=10;" value="Local-only notes&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;providers/local.py — ENV=dev|production selects&lt;br&gt;Root/MasterETL/{ENV}/lakehouse as the datalake root.&lt;br&gt;&lt;br&gt;--spark_engine and --write_format are parsed fresh&lt;br&gt;by EACH script (argparse) — the diagram shows this&lt;br&gt;branch twice because it's a real per-invocation choice,&lt;br&gt;not a value that carries over automatically. Convention&lt;br&gt;is to reuse the same --write_format for script 2 that&lt;br&gt;script 1 used, since t1 is read in that format.&lt;br&gt;&lt;br&gt;delta is reachable only via java: jars/catalogs load at&lt;br&gt;JVM boot, so preprovision_local_jvm_spark() must run&lt;br&gt;before get_spark() whenever write_format is iceberg or&lt;br&gt;delta AND engine is java.&lt;/font&gt;" vertex="1">
          <mxGeometry height="260" width="340" x="880" y="530" as="geometry" />
        </mxCell>

