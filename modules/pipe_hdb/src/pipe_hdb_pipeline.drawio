        </mxCell>

        <mxCell id="stage0" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="0_land_csv.py&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;fetch_datagov_csv() per era, --mode update|backfill&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="300" x="390" y="180" as="geometry" />
        </mxCell>

        <mxCell id="landingL" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Local FS landing dir&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;providers/local.py — get_landing_dir()&lt;br&gt;Root/MasterETL/{ENV}/lakehouse/landing/&lt;/font&gt;" vertex="1">
