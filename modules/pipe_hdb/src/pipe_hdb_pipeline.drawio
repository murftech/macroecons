        </mxCell>

        <mxCell id="src" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" value="data.gov.sg API&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;5 CSV eras: 1990-1999, 2000-2012Feb, 2012Mar-2014, 2015-2016, 2017-onwards&lt;/font&gt;" vertex="1">
