          <mxGeometry height="80" width="300" x="390" y="410" as="geometry" />
        </mxCell>

        <!-- Stage 1 engine branch -->
        <mxCell id="eng1Sail" parent="1" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="--spark_engine sail&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PySail (default) — no JVM preprovision needed&lt;/font&gt;" vertex="1">
