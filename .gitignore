# Ignore everything by default
*
!*/


# Allow everything inside them
!/cloud_aws_shared/**
!/cloud_gcp_shared/**
!/modules/**
# !/modules/pipe_hdb_cli/**
# !/modules/pipe_hdb_databricks/**
# !/modules/pipe_hdb_minimal/**



!/streamlit/**

# Allow these specific top-level files
!/.dockerignore
!/.gitignore
!/.gcloudignore
!/requirements_dev_commons.txt
!/*.sh
!/.gitattributes
!/README.md

# Re-exclude junk inside the allowed trees
**/*.bak.*
**/__pycache__/
**/.DS_Store
**/.venv/
**/venv/
**/*.egg-info/
**/*.pyc
**/.DS_Store
**/output/
**/hive/
**/localdata/
**/tmp/
**/datalake/
**/.Rproj.user/
**/*.Rhistory