{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowReadChartObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::murftech-macroecons/*"
    },
    {
      "Sid": "AllowListBucketContents",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::murftech-macroecons"
    },
    {
      "Sid": "AllowTriggerAndPollThePipelineTask",
      "Effect": "Allow",
      "Action": ["ecs:RunTask", "ecs:DescribeTasks"],
      "Resource": "*"
    },
    {
      "Sid": "AllowPassingThePipelineTaskRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::717741926071:role/hdb-pipeline-execution-role",
        "arn:aws:iam::717741926071:role/hdb-pipeline-task-role"
      ]
    }
  ]
}
